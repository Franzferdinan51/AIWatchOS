# sdkconfig.defaults for AIWatchOS — Waveshare ESP32-S3-Touch-AMOLED-2.06
# Target: ESP32-S3R8, 8 MB octal PSRAM, 32 MB flash, 410x502 CO5300 AMOLED

# --- Chip target ---
CONFIG_IDF_TARGET="esp32s3"

# --- Flash / partition scheme ---
CONFIG_BOOTLOADER_VDD_SPI_INIT_CLK=1
CONFIG_ESPTOOLPY_FLASH_MODE_QSPI=1
CONFIG_ESPTOOLPY_FLASH_SIZE_4MB=1
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_CUSTOM=y

# --- PSRAM (8 MB octal) ---
CONFIG_SPIRAM_USE_MALLOC=1
CONFIG_SPIRAM_BOOT_INIT=1
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=1
CONFIG_SPIRAM_RODATA=1
CONFIG_SPIRAM_CACHE_8M=1

# --- CPU / RTOS ---
CONFIG_FREERTOS_HZ=100
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# --- Display (CO5300 QSPI, 410x502) ---
CONFIG_LCD_RGB_H_RES=410
CONFIG_LCD_RGB_V_RES=502

# --- I2C for touch / PMU / codecs ---
CONFIG_I2C_MASTER_SCL_GPIO=14
CONFIG_I2C_MASTER_SDA_GPIO=15
CONFIG_I2C_MASTER_FREQ_HZ=400000

# --- WiFi (for AI connectivity) ---
CONFIG_WIFI_ENABLED=y
CONFIG_ESP_WIFI_AUTH_OPEN=y
