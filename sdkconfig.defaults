# sdkconfig.defaults for AIWatchOS — Waveshare ESP32-S3-Touch-AMOLED-2.06
# Target: ESP32-S3R8, 8 MB octal PSRAM, 32 MB flash, 410x502 CO5300 AMOLED
# NOTE: bool symbols use =y (bare =1 is ignored by Kconfig).

# --- Chip target ---
CONFIG_IDF_TARGET="esp32s3"

# --- Flash (32 MB; partition table needs ~10.5 MB) ---
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# --- PSRAM (S3R8 = 8 MB octal = ESP-PSRAM64) ---
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y

# --- CPU / RTOS ---
CONFIG_FREERTOS_HZ=100
CONFIG_COMPILER_OPTIMIZATION_PERF=y
