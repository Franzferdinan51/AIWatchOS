# sdkconfig.defaults for AIWatchOS — Waveshare ESP32-S3-Touch-AMOLED-2.06
# Target: ESP32-S3R8, 8 MB octal PSRAM, 32 MB flash, 410x502 CO5300 AMOLED
# NOTE: bool symbols use =y (bare =1 is ignored by Kconfig).

# --- Chip target ---
CONFIG_IDF_TARGET="esp32s3"

# --- Flash (32 MB; partition table needs ~10.5 MB) ---
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# --- PSRAM (S3R8 = 8 MB octal = ESP-PSRAM64) ---
# Aligned with the Meta muse-gadget-sdk reference board config
# (esp32/devices/sdkconfig.muse-waveshare-s3-175c): XIP + BSS-in-PSRAM
# keep internal RAM free for DMA, and WiFi/LWIP may allocate from PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# NOTE (deferred to the link/BLE bring-up): cache sizes, BT sleep, WiFi TX
# buffers, power management and LVGL draw units from the reference config.

# --- CPU / RTOS ---
CONFIG_FREERTOS_HZ=100
CONFIG_COMPILER_OPTIMIZATION_PERF=y
