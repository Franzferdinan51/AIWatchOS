menu "Hermes Gadget Client"

# WiFi is owned by the shared network component (components/aiwatchos_net):
# this app keeps NO WiFi settings of its own. The watch joins the network
# configured under "AIWatchOS Network" (Kconfig) or provisioned into the
# NVS namespace "aiwnet"; with no WiFi configured there, the Hermes app
# stays fully offline (LINK OFFLINE), as before.

config HERMES_HOST
    string "Hermes hub host"
    default "192.168.1.96"
    help
        Host running the Hermes gadget plugin hub. The client connects
        to ws://<host>:<port>/gadget.

config HERMES_PORT
    int "Hermes hub port"
    default 8765
    range 1 65535

config HERMES_DEVICE_NAME
    string "Device name announced to Hermes"
    default "AIWatchOS"
    help
        Shown in the Hermes host's device list after enrollment.

endmenu
